# Berwa Collections — Environment Variables
# Copy this file to .env.local and fill in your real values.
# Never commit .env.local to version control.

# ─── Supabase (Frontend — VITE_ prefix makes them available in the browser) ───
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── Supabase (Backend / Server-side only — do NOT prefix with VITE_) ─────────
# Used by Vercel serverless functions and Supabase Edge Functions only.
# SUPABASE_URL is deliberately not VITE_-prefixed. Keep both values out of
# browser-served .env files and configure them in Vercel instead.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── App ──────────────────────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:5173
